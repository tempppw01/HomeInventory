{
  "name": "home-inventory",
  "version": "0.0.8",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:init:sqlite": "tsx scripts/init-sqlite.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:backfill": "tsx scripts/backfill-item-codes.ts",
    "db:normalize": "tsx scripts/normalize-items.ts",
    "db:setup": "npm run db:generate && npm run db:init:sqlite && npm run db:seed && npm run db:backfill && npm run db:normalize",
    "test:unit": "node --experimental-strip-types --test \"scripts/unit/*.test.mjs\"",
    "test:api": "node scripts/api-contract-test.mjs && node scripts/verify-task-recurrence.mjs && node scripts/verify-backup-dates.mjs && node scripts/verify-account-ops.mjs",
    "test:auth": "node scripts/auth-matrix-test.mjs",
    "test:backup": "node scripts/backup-roundtrip-test.mjs",
    "test:edge": "node scripts/edge-input-test.mjs",
    "test:scale": "node scripts/scale-perf-test.mjs",
    "test:ui": "node scripts/verify-experience.mjs && node scripts/verify-entry-fixes.mjs && node scripts/verify-report-page.mjs && node scripts/verify-narrow-layout.mjs && node scripts/verify-layout-budget.mjs",
    "test:all": "sh scripts/run-all-tests.sh",
    "test:p2": "node scripts/verify-p2-features.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "ali-oss": "^6.23.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "16.2.10",
    "prisma": "^6.19.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.9.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
