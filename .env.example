DATABASE_PROVIDER=sqlite
DATABASE_URL="file:../data/home-inventory.db"
NEXT_PUBLIC_APP_NAME="归物"
SEED_DEMO_DATA="auto"
# 可选：设置后启用家庭访问密码，并保护所有数据 API
# APP_PASSWORD="请设置一个强密码"
# IMAGE_STORAGE_MODE="local" # local、oss 或 both；不填写时默认为 local
# LOCAL_UPLOAD_DIR="/app/data/uploads"

# 可选：使用环境变量托管阿里云 OSS（优先于界面设置）
# OSS_REGION="oss-cn-hangzhou"
# OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
# OSS_BUCKET="your-bucket"
# OSS_DIRECTORY="home-inventory"
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
# OSS_PUBLIC_BASE_URL="https://your-bucket.oss-cn-hangzhou.aliyuncs.com"

# 可选：使用环境变量托管 OpenAI 兼容接口（优先于界面设置）
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5.5"

# 可选：Cloudflare Tunnel（启动命令见 README，令牌请勿提交到仓库）
# CLOUDFLARE_TUNNEL_TOKEN=""
