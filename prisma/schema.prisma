generator client {
  provider      = "prisma-client-js"
  // 只生成构建机(容器内 alpine)对应的引擎,避免把全平台二进制打进镜像。
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ItemType {
  DURABLE
  CONSUMABLE
}

enum ShoppingStatus {
  PENDING
  PURCHASED
}

enum TaskStatus {
  OPEN
  DONE
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                  String           @id @default(cuid())
  username            String           @unique
  displayName         String
  passwordHash        String
  // 一次性恢复码(忘记密码时用)。只保存不可逆哈希,重置成功后立即轮换。
  recoveryCodeHash    String?
  recoveryGeneratedAt DateTime?
  role                UserRole         @default(MEMBER)
  active              Boolean          @default(true)
  member              HouseholdMember?
  activities          ActivityLog[]
  sessions            AuthSession[]
  loginRecords        LoginRecord[]
  chatMessages        AiChatMessage[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model AiChatMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Int
  role        String
  content     String
  attachments String?
  itemDraft   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, position])
  @@index([userId, updatedAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String   @default("未知设备")
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginRecord {
  id            String   @id @default(cuid())
  userId        String?
  username      String
  ipAddress     String?
  device        String
  userAgent     String?
  success       Boolean  @default(false)
  failureReason String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Location {
  id           String     @id @default(cuid())
  name         String     @unique
  icon         String     @default("Package")
  color        String     @default("#7c3aed")
  thumbnailUrl String?
  parentId     String?
  parent       Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Location[] @relation("LocationHierarchy")
  items        Item[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Item {
  id                    String        @id @default(cuid())
  itemCode              String?       @unique
  name                  String
  category              String
  type                  ItemType      @default(DURABLE)
  quantity              Float         @default(1)
  minQuantity           Float         @default(0)
  remainingPercent      Float         @default(100)
  unit                  String        @default("件")
  price                 Float?
  purchaseDate          DateTime?
  expiryDate            DateTime?
  imageUrl              String?
  notes                 String?
  aiSummary             String?
  aiStorageAdvice       String?
  aiUsageAdvice         String?
  aiReplenishmentAdvice String?
  /**
   * 后台自动判定的存放建议:COLD=需冷藏 / COLD_AFTER_OPEN=开封后冷藏 / ROOM=常温即可
   */
  storage               String?
  /**
   * 上述判定的依据,给用户看的一句话
   */
  storageReason         String?
  /**
   * 后台自动打的标签(逗号分隔),参与搜索
   */
  autoTags              String?
  locationId            String?
  location              Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  priceRecords          PriceRecord[]
  activities            ActivityLog[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  restockPausedUntil    DateTime?
  consumeRate           Float         @default(0)
  lastRestockedAt       DateTime?

  @@index([type])
  @@index([category])
  @@index([locationId])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([lastRestockedAt])
}

model HouseholdMember {
  id         String        @id @default(cuid())
  name       String
  color      String        @default("#7c3aed")
  activities ActivityLog[]
  userId     String?       @unique
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ActivityLog {
  id            String           @id @default(cuid())
  action        String
  itemId        String?
  itemName      String?
  memberId      String?
  userId        String?
  detail        String?
  undoOfId      String?
  undoneAt      DateTime?
  // 余量型消耗(液体按刻度记)才有的两个字段:撤销时据此把余量放回去,
  // 而不是像数量型那样给 quantity 加 1(那样会凭空多出一瓶,实测 quantity 1 → 2)。
  percentBefore Float?
  percentAfter  Float?
  scanRequestId String?          @unique
  item          Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
  member        HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([itemId])
  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@index([undoOfId])
}

model PriceRecord {
  id          String   @id @default(cuid())
  itemId      String?
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName    String
  category    String
  unitPrice   Float
  quantity    Float    @default(1)
  totalPrice  Float
  purchasedAt DateTime @default(now())
  store       String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([itemId])
  @@index([purchasedAt])
  @@index([category])
}

model OssSetting {
  id              String   @id @default("default")
  storageMode     String   @default("oss")
  localDirectory  String   @default("/app/data/uploads")
  region          String
  endpoint        String?
  bucket          String
  directory       String   @default("home-inventory")
  accessKeyId     String
  accessKeySecret String
  publicBaseUrl   String?
  updatedAt       DateTime @updatedAt
}

model AiSetting {
  id        String   @id @default("default")
  baseUrl   String
  apiKey    String
  model     String
  updatedAt DateTime @updatedAt
}

model ShoppingItem {
  id         String         @id @default(cuid())
  name       String
  quantity   Float          @default(1)
  unit       String         @default("件")
  category   String?
  priority   Int            @default(1)
  status     ShoppingStatus @default(PENDING)
  source     String         @default("manual")
  isFavorite Boolean        @default(false)
  // 采购入库的记账:入了多少、入到哪件物品、什么时候入的。
  // 有了这三个字段,重复点「已购买」不会重复加库存,撤销也能把量退回去。
  stockedAt      DateTime?
  stockedQuantity Float?
  stockedItemId  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
}

model HouseholdPreference {
  id                  String    @id @default("default")
  expiryReminderDays  Int       @default(7)
  lowStockReminder    Boolean   @default(true)
  weeklyReviewEnabled Boolean   @default(true)
  weeklyReviewDay     Int       @default(0)
  lastAutoBackupAt    DateTime?
  updatedAt           DateTime  @updatedAt
}

/// 盘点历史。此前只存在浏览器 localStorage —— 换设备或清缓存就丢了,
/// 而「最近一次盘点了多少件、确认了多少」恰恰是该长期留存的记录。
model AuditRecord {
  id           String   @id @default(cuid())
  userId       String?
  total        Int
  confirmed    Int
  locationName String   @default("全部空间")
  finishedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([finishedAt])
}

model HouseholdTask {
  id          String     @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  recurrence  String     @default("NONE")
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  nextDueAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([dueAt])
  @@index([nextDueAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  userId    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// 离线队列的幂等凭据:同一个 opId 只应用一次。
///
/// 为什么需要它:离线改动会在网络恢复时重放,而重放可能重复发送(网络抖一下、页面刷新、
/// 用户手动重试)。对「消耗 1 件」这种操作,重复一次就是**多消耗一件**——数据真的少了。
/// 先例是 ActivityLog.scanRequestId(扫码消耗就是用它去重的),这里把它推广成通用的一把钥匙:
/// 客户端每个写操作带一个 opId,服务端见过就回上次的结果,不再落库。
model SyncOperation {
  id         String   @id @default(cuid())
  opId       String   @unique
  action     String
  resultJson String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
