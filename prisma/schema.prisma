generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ItemType {
  DURABLE
  CONSUMABLE
}

enum ShoppingStatus {
  PENDING
  PURCHASED
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String            @id @default(cuid())
  username     String            @unique
  displayName  String
  passwordHash String
  role         UserRole          @default(MEMBER)
  active       Boolean           @default(true)
  member       HouseholdMember?
  activities   ActivityLog[]
  sessions     AuthSession[]
  loginRecords LoginRecord[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginRecord {
  id            String   @id @default(cuid())
  userId        String?
  username      String
  ipAddress     String?
  device        String
  userAgent     String?
  success       Boolean  @default(false)
  failureReason String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("Package")
  color     String   @default("#7c3aed")
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id                    String        @id @default(cuid())
  itemCode              String?       @unique
  name                  String
  category              String
  type                  ItemType      @default(DURABLE)
  quantity              Float         @default(1)
  minQuantity           Float         @default(0)
  remainingPercent      Float         @default(100)
  unit                  String        @default("件")
  price                 Float?
  purchaseDate          DateTime?
  expiryDate            DateTime?
  imageUrl              String?
  notes                 String?
  aiSummary             String?
  aiStorageAdvice       String?
  aiUsageAdvice         String?
  aiReplenishmentAdvice String?
  locationId            String?
  location              Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  priceRecords          PriceRecord[]
  activities            ActivityLog[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  restockPausedUntil    DateTime?

  @@index([type])
  @@index([category])
  @@index([locationId])
  @@index([expiryDate])
  @@index([deletedAt])
}

model HouseholdMember {
  id         String        @id @default(cuid())
  name       String
  color      String        @default("#7c3aed")
  activities ActivityLog[]
  userId     String?       @unique
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ActivityLog {
  id         String            @id @default(cuid())
  action     String
  itemId     String?
  itemName   String?
  memberId   String?
  userId     String?
  detail     String?
  undoOfId   String?
  undoneAt   DateTime?
  scanRequestId String?         @unique
  item       Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  member     HouseholdMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([itemId])
  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@index([undoOfId])
}

model PriceRecord {
  id          String   @id @default(cuid())
  itemId      String?
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName    String
  category    String
  unitPrice   Float
  quantity    Float    @default(1)
  totalPrice  Float
  purchasedAt DateTime @default(now())
  store       String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([itemId])
  @@index([purchasedAt])
  @@index([category])
}

model OssSetting {
  id              String   @id @default("default")
  storageMode     String   @default("oss")
  localDirectory  String   @default("/app/data/uploads")
  region          String
  endpoint        String?
  bucket          String
  directory       String   @default("home-inventory")
  accessKeyId     String
  accessKeySecret String
  publicBaseUrl   String?
  updatedAt       DateTime @updatedAt
}

model AiSetting {
  id        String   @id @default("default")
  baseUrl   String
  apiKey    String
  model     String
  updatedAt DateTime @updatedAt
}

model ShoppingItem {
  id        String         @id @default(cuid())
  name      String
  quantity  Float          @default(1)
  unit      String         @default("件")
  category  String?
  priority  Int            @default(1)
  status    ShoppingStatus @default(PENDING)
  source    String         @default("manual")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}
